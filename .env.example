# Porta do servidor web da dashboard
PORT=4178

# ==========================================================
#  MODO DE EXECUÇÃO DO AGENTE
#  Opções: mock | paper_mainnet | simulate_rpc | live_mainnet
#   - mock          : dados locais/fake, sem rede (mais seguro)
#   - paper_mainnet : lê dados REAIS do mainnet, mas NUNCA envia tx
#   - simulate_rpc  : monta tx real e roda simulateTransaction (não comete)
#   - live_mainnet  : NÃO SEGURO — envia transações reais (custa SOL)
# ==========================================================
AGENT_MODE=paper_mainnet

# Rede padrão (relevante p/ modos que tocam a rede)
# true=devnet (teste), false=mainnet-beta
USE_DEVNET=false

# Valores obrigatórios para modos mainnet (paper/simulate/live)
# Use Helius/QuickNode/Triton com chave. NÃO use um RPC público sem rate limit.
MAINNET_RPC_URL=
MAINNET_WS_URL=

# Programa da Pump.fun (a maioria dos projetos usa este; valide com: npm run validate)
PUMP_FUN_PROGRAM=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P

# ==========================================================
#  TRAVAS DE SEGURANÇA (OBRIGATÓRIAS p/ live_mainnet)
# ==========================================================
# NUNCA envie transações reais a menos que:
#   AGENT_MODE=live_mainnet
#   ALLOW_REAL_MODE=true
#   ENABLE_LIVE_TRADING=true
#   I_UNDERSTAND_LIVE_RISK=YES
ALLOW_REAL_MODE=false
ENABLE_LIVE_TRADING=false
REQUIRE_LIVE_CONFIRMATION=true
I_UNDERSTAND_LIVE_RISK=NO
COMMITMENT=confirmed

# ==========================================================
#  PAPER TRADING (modo paper_mainnet)
# ==========================================================
PAPER_INITIAL_SOL=1.0        # Caixa virtual inicial
PAPER_FEE_BPS=100            # Fee simulada (100 = 1%)
PAPER_SLIPPAGE_BPS=50        # Slippage simulada (0.5%)
PAPER_LATENCY_MS=250         # Latência simulada

# ==========================================================
#  LIMITES DE RISCO (aplicam-se a todos os modos de dados reais)
# ==========================================================
MAX_SOL_PER_TRADE=0.05       # Máx a gastar por compra
MAX_DAILY_LOSS_SOL=0.20      # Máx perda diária
MAX_OPEN_POSITIONS=5         # Máx posições simultâneas
MIN_ENTRY_INTERVAL_MS=8000   # Espera mínima entre entradas (cooldown)
RESERVE_SOL=0.05             # Saldo reservado que nunca é usado em entradas
DAILY_TARGET_PCT=10          # Meta diária de lucro (%) — ao atingir, para novas entradas
DAILY_LOSS_PCT=20            # Loss máximo diário (%) — ao atingir, para a negociação

# --- Parâmetros de trading (sobrescrevíveis pela interface) ---
BUY_AMOUNT_SOL=0.015
SELL_TRIGGER_PCT=20
STOP_LOSS_PCT=15
SLIPPAGE_BPS=500
PRIORITY_FEE_LAMPORTS=10000
MAX_BONDING_CURVE=100
AUTO_SELL_ON_BUY=true

# ==========================================================
#  NOVOS PARÂMETROS SNIPER PUMP.FUN
# ==========================================================
MIN_ENTRY_SCORE=70
TARGET_PROFIT_PCT=20
MAX_POSITION_TIME_SECONDS=300
MIN_LIQUIDITY_SOL=5
MIN_VIRTUAL_SOL_RESERVES=10
FIRST_BUY_WINDOW_SECONDS=30
FIRST_BUY_COUNT=5
MIN_UNIQUE_BUYERS=2

# Análise estratégica de entrada/saída
FORCE_ENTRY_ON_NEW_LAUNCH=false  # NUNCA pula validação — lançamento novo só relaxa "primeiras compras"
MIN_BUY_SELL_RATIO=1.2           # Relação mínima volume de compra/venda p/ confirmar fluxo
MAX_BUYER_CONCENTRATION=0.7      # Rejeita se a maior carteira dominar >70% do volume de compra
MAX_IMPACT_PCT=2.0               # Impacto máx da nossa ordem sobre a liquidez (%), acima = REJEITA
TRAILING_ACTIVATE_PCT=5          # Ativa trailing stop quando lucro ≥ 5%
TRAILING_RETAIN_PCT=60           # Trava 60% do pico de lucro (caiu abaixo = vende)

# Pesos do entryScore (JSON)
ENTRY_SCORE_WEIGHTS={"newToken":20,"tradable":20,"liquidity":15,"firstBuys":15,"buyPressure":10,"uniqueBuyers":10,"lowRisk":10}
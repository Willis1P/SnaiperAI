# ============================================================
#  SNIPERAI DASHBOARD - CONFIGURAÇÃO DE AMBIENTE
#  Copie para .env e preencha com SUAS chaves
#  NUNCA commite o .env real no Git!
# ============================================================

# Porta do servidor web da dashboard
PORT=4178

# ============================================================
#  MODO DE EXECUÇÃO DO AGENTE
#  Opções: mock | paper_mainnet | simulate_rpc | live_mainnet
#   - mock          : dados locais/fake, sem rede (mais seguro)
#   - paper_mainnet : lê dados REAIS do mainnet, mas NUNCA envia tx
#   - simulate_rpc  : monta tx real e roda simulateTransaction (não comete)
#   - live_mainnet  : NÃO SEGURO — envia transações reais (custa SOL)
# ============================================================
AGENT_MODE=paper_mainnet

# Rede padrão (true=devnet para teste, false=mainnet-beta)
USE_DEVNET=false

# ============================================================
#  RPC MAINNET (OBRIGATÓRIO para paper_mainnet/simulate/live)
#  Pegue sua chave GRÁTIS em: https://helius.xyz
#  Exemplo: https://mainnet.helius-rpc.com/?api-key=abc123-def456
# ============================================================
MAINNET_RPC_URL=https://mainnet.helius-rpc.com/?api-key=SUA_CHAVE_HELIUS_AQUI
MAINNET_WS_URL=wss://mainnet.helius-rpc.com/?api-key=SUA_CHAVE_HELIUS_AQUI

# Programa da Pump.fun (não altere a menos que mude)
PUMP_FUN_PROGRAM=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P

# Jupiter API Key (pegue em jup.ag/api)
JUPITER_API_KEY=jup_5c28d80dd9542a4aadd821ce03692354c4a4a5337df318eed774ce284ed25b34

# ============================================================
#  TRAVAS DE SEGURANÇA (OBRIGATÓRIAS para live_mainnet)
#  Mantenha FALSE para paper_mainnet
# ============================================================
ALLOW_REAL_MODE=false
ENABLE_LIVE_TRADING=false
REQUIRE_LIVE_CONFIRMATION=true
I_UNDERSTAND_LIVE_RISK=NO
COMMITMENT=confirmed

# ============================================================
#  PAPER TRADING (modo paper_mainnet)
# ============================================================
PAPER_INITIAL_SOL=1.0        # Caixa virtual inicial
PAPER_FEE_BPS=100            # Fee simulada (100 = 1%)
PAPER_SLIPPAGE_BPS=50        # Slippage simulada (0.5%)
PAPER_LATENCY_MS=100         # Latência simulada

# ============================================================
#  LIMITES DE RISCO
# ============================================================
MAX_SOL_PER_TRADE=0.05       # Máx a gastar por compra
MAX_DAILY_LOSS_SOL=0.20      # Máx perda diária
MAX_OPEN_POSITIONS=10        # Máx posições simultâneas

# ============================================================
#  PARÂMETROS DE TRADING (sobrescrevíveis pela interface)
# ============================================================
BUY_AMOUNT_SOL=0.015
SELL_TRIGGER_PCT=20
STOP_LOSS_PCT=15
SLIPPAGE_BPS=500
PRIORITY_FEE_LAMPORTS=10000
MAX_BONDING_CURVE=100
AUTO_SELL_ON_BUY=true

# ============================================================
#  PARÂMETROS SNIPER PUMP.FUN (OTIMIZADOS PARA ENTRADA RÁPIDA)
# ============================================================
MIN_ENTRY_SCORE=40
TARGET_PROFIT_PCT=20
MAX_POSITION_TIME_SECONDS=300
MIN_LIQUIDITY_SOL=1
MIN_VIRTUAL_SOL_RESERVES=5
FIRST_BUY_WINDOW_SECONDS=10
FIRST_BUY_COUNT=1
MIN_UNIQUE_BUYERS=1

# Force entry em lançamentos muito novos (ignora validações de liquidez)
FORCE_ENTRY_ON_NEW_LAUNCH=true
MAX_NEW_LAUNCH_AGE_SECONDS=30

# Pesos do entryScore (ajuste se quiser)
ENTRY_SCORE_WEIGHTS={"newToken":30,"tradable":20,"liquidity":10,"firstBuys":15,"buyPressure":10,"uniqueBuyers":5,"lowRisk":10}

# ============================================================
#  MONITORAMENTO
# ============================================================
MONITOR_INTERVAL_MS=1000